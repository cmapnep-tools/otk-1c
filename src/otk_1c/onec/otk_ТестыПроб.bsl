// Пробы ОТК для YAxUnit. Список проб — yax-plan.json в каталоге workspacePath конфигурации
// запуска: [{"name", "context" (Сервер|КлиентУправляемоеПриложение|КлиентОбычноеПриложение),
// "kind" (expr|form|open|query), "expr", "expect" (missing|none)}]. form — получить форму (компиляция,
// ПриСозданииНаСервере); open — дымовой тест: получить, открыть и закрыть форму.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	План = ПрочитатьПлан();
	Если План = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Проба Из План Цикл
		ЮТТесты.ДобавитьТест("Проба", Проба.name, , Проба.context)
			.СПараметрами(Проба.kind, Проба.expr, Проба.expect);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура Проба(Вид, Выражение, Ожидание) Экспорт

	Если Вид = "form" Тогда
		#Если Клиент Тогда
		ПолучитьФорму(Выражение);
		#КонецЕсли
		Возврат;
	ИначеЕсли Вид = "open" Тогда
		#Если Клиент Тогда
		// ход — в smoke-progress.txt: зависшую форму (модальное окно, вопрос) ОТК узнает по последней строке
		ОтметитьХод("start", Выражение);
		Форма = ПолучитьФорму(Выражение);
		Если Форма = Неопределено Тогда
			ОтметитьХод("skip", Выражение);
			ЮТест.Пропустить("форма отказалась открываться без параметров (Отказ при создании)");
			Возврат;
		КонецЕсли;
		Форма.Открыть();
		Если Форма.Открыта() Тогда
			Форма.Закрыть();
		КонецЕсли;
		ОтметитьХод("done", Выражение);
		#КонецЕсли
		Возврат;
	ИначеЕсли Вид = "query" Тогда
		#Если Сервер Тогда
		Запрос = Новый Запрос(Выражение);
		Запрос.НайтиПараметры();
		#КонецЕсли
		Возврат;
	КонецЕсли;

	Если Ожидание = "none" Тогда
		Выполнить(Выражение);
		Возврат;
	КонецЕсли;
	Попытка
		Выполнить(Выражение);
	Исключение
		Если СтрНайти(ИнформацияОбОшибке().Описание, "__ОТКПроба__") > 0 Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ВызватьИсключение "Проба не вызвала ожидаемую ошибку: " + Выражение;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьПлан()

	ПараметрыЗапуска = ЮТКонтекстСлужебный.ПараметрыЗапуска();
	Каталог = ?(ПараметрыЗапуска = Неопределено, "", ПараметрыЗапуска.workspacePath);
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Каталог + ПолучитьРазделительПути() + "yax-plan.json", "UTF-8");
	План = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат План;

КонецФункции

Процедура ОтметитьХод(Событие, Выражение)

	ПараметрыЗапуска = ЮТКонтекстСлужебный.ПараметрыЗапуска();
	Каталог = ?(ПараметрыЗапуска = Неопределено, "", ПараметрыЗапуска.workspacePath);
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат;
	КонецЕсли;
	// файл может быть кратко занят (чтение ОТК, антивирус): отметка хода — диагностика, её сбой не ошибка
	// пробы; несколько попыток, затем отметка пропускается
	Для НомерПопытки = 1 По 5 Цикл
		Запись = Неопределено;
		Попытка
			Запись = Новый ЗаписьТекста(Каталог + ПолучитьРазделительПути() + "smoke-progress.txt", "UTF-8", , Истина);
			Запись.ЗаписатьСтроку(Событие + "|" + Выражение);
			Запись.Закрыть();
			Возврат;
		Исключение
			Запись = Неопределено;   // открытый файл закрывается при освобождении объекта
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
