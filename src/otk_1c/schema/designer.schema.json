{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmapnep-tools.github.io/otk-1c/schema/designer.v1.json",
  "title": "Шаг designer (designer.json): проверка всех модулей Конфигуратором в прогоне gate --designer",
  "type": "object",
  "required": ["schema", "version", "plan", "ran", "modes", "findings", "notes", "infra", "timings"],
  "properties": {
    "$comment": {"type": "string", "description": "внутренний файл ОТК, не контракт"},
    "schema": {"const": "otk.designer.v1"},
    "version": {"type": "string", "description": "версия ОТК"},
    "plan": {"type": "string", "description": "отпечаток плана (model.plan_id)"},
    "ran": {"type": "boolean", "description": "проверка выполнена целиком: контроль сработал, вывод разобран — снимает designer:*"},
    "modes": {"type": "array", "items": {"type": "string"}, "description": "ключи режимов /CheckModules"},
    "control": {"type": ["object", "null"], "required": ["ok", "detail"]},
    "rc": {"type": ["integer", "null"]},
    "findings": {"type": "array", "description": "ошибки, новые относительно базовой линии (load — выгрузка не загрузилась)",
                 "items": {"type": "object", "required": ["object", "file", "line", "col", "message", "code", "modes"],
                           "properties": {"object": {"type": "string"}, "file": {"type": ["string", "null"]},
                                          "line": {"type": "integer"}, "col": {"type": "integer"},
                                          "message": {"type": "string"}, "code": {"type": "string"},
                                          "modes": {"type": "array", "items": {"type": "string"}},
                                          "load": {"type": "boolean"}}}},
    "known": {"type": "integer"},
    "fixed": {"type": "integer"},
    "baseline": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "infra": {"type": "array", "items": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string"}, "reasonCode": {"type": ["string", "null"], "description": "код места сбоя; null — по тексту"}}}, "description": "сбой: код выхода 2"},
    "timings": {"type": "object"}
  }
}
