{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmapnep-tools.github.io/otk-1c/schema/summary.v1.json",
  "title": "Сводка прогона (summary.json)",
  "description": "Собирается только из файлов шагов: otk.json, static.json, run.json, designer.json",
  "type": "object",
  "required": ["schema", "version", "code", "verdict", "base", "head", "modules", "queries", "findings",
               "notChecked", "uncovered", "notes", "scenarios", "smoke", "timings"],
  "properties": {
    "schema": {"const": "otk.summary.v1"},
    "version": {"type": "string", "description": "версия ОТК"},
    "code": {"enum": [0, 1, 2], "description": "0 — можно отправлять, 1 — есть ошибки, 2 — сбой инфраструктуры или ничего не проверено"},
    "verdict": {"type": "string"},
    "base": {"type": ["string", "null"]},
    "head": {"type": "string"},
    "modules": {"type": "integer", "description": "модулей плана и зависимых"},
    "queries": {"type": "integer"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "notChecked": {"type": "array",
                   "items": {"type": "object", "required": ["what", "reason"],
                             "properties": {"check": {"type": "string", "description": "проверка реестра; без file — не выполнена целиком, с file — по модулю (видно в JUnit и Problems)"},
                                            "what": {"type": "string"}, "file": {"type": ["string", "null"]},
                                            "line": {"type": ["integer", "null"]}, "reason": {"type": ["string", "null"]},
                                            "needs": {"type": "string", "pattern": "^(designer:.+|ui|publication)$", "description": "чем закрыть: designer:<контекст> — полная проверка Конфигуратором в режиме (* — во всех), ui — UI/сценарные тесты, publication — проверка с публикацией сервиса"}}}},
    "uncovered": {"type": "array", "description": "не покрыто этим прогоном: чем закрыть",
                  "items": {"type": "object", "required": ["owner", "file", "context", "needs", "reason"],
                            "properties": {"owner": {"type": ["string", "null"]}, "file": {"type": ["string", "null"]},
                                           "context": {"type": ["string", "null"]}, "needs": {"type": "string", "pattern": "^(designer:.+|ui|publication)$", "description": "чем закрыть: designer:<контекст> — полная проверка Конфигуратором в режиме (* — во всех), ui — UI/сценарные тесты, publication — проверка с публикацией сервиса"},
                                           "reason": {"type": ["string", "null"]}}}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "infra": {"type": "array", "items": {"type": "object", "required": ["reasonCode", "message"], "properties": {"reasonCode": {"type": "string", "description": "как в gate-result"}, "message": {"type": "string"}}}, "description": "сбои инфраструктуры (код 2); те же тексты — и в notes"},
    "scenarios": {"type": "object", "required": ["selected", "run", "failed", "skipped", "extensions"]},
    "smoke": {"type": "object", "required": ["selected", "opened", "skipped", "failed"]},
    "timings": {"type": "object"},
    "designer": {"type": "object", "description": "шаг designer (gate --designer): проверка всех модулей Конфигуратором в той же копии ИБ",
                 "required": ["ran", "modes", "control", "baseline", "known", "fixed", "new", "closed"],
                 "properties": {"ran": {"type": "boolean", "description": "выполнена целиком (контроль сработал, вывод разобран)"},
                                "modes": {"type": "array", "items": {"type": "string"}},
                                "control": {"type": ["object", "null"]}, "baseline": {"type": ["string", "null"]},
                                "known": {"type": "integer", "description": "ошибок базовой линии"},
                                "fixed": {"type": "integer", "description": "исправлено ошибок базовой линии"},
                                "new": {"type": "integer", "description": "новых ошибок (находки шага designer)"},
                                "closed": {"type": "integer", "description": "снято с «не покрыто» и «не проверено» (needs designer:*)"}}}
  },
  "$defs": {
    "finding": {"type": "object", "required": ["severity", "step", "rule", "file", "line", "column", "message",
                                               "sources"],
                "properties": {"severity": {"enum": ["error", "warning"]},
                               "step": {"type": "string", "description": "static, run:<исполнитель> или designer (проверка всех модулей Конфигуратором)"},
                               "rule": {"type": "string"}, "file": {"type": ["string", "null"]},
                               "line": {"type": "integer"}, "column": {"type": "integer"},
                               "message": {"type": "string"}, "count": {"type": "integer"},
                               "context": {"type": ["string", "null"]},
                               "object": {"type": "string", "description": "объект 1С модуля: ОбщийМодуль.Х, Справочник.Т.Форма.Ф"},
                               "method": {"type": "string", "description": "метод по строке; нет — тело модуля или не определить"},
                               "place": {"type": "string", "description": "место для «Перейти к строке» Конфигуратора: ОбщийМодуль.Х.Модуль(120)"},
                               "text": {"type": "string", "description": "строка кода проверенной редакции (обрезанная)"},
                               "sources": {"type": "array", "minItems": 1,
                                           "description": "проверки, давшие находку: первая — основная, по ней step/code/message",
                                           "items": {"type": "object", "required": ["step", "rule"],
                                                     "properties": {"step": {"type": "string"}, "rule": {"type": "string"},
                                                                    "context": {"type": ["string", "null"]},
                                                                    "message": {"type": "string"},
                                                                    "modes": {"type": "array", "items": {"type": "string"}, "description": "designer: режимы проверки Конфигуратора, в которых ошибка"}}}}}}
  }
}
