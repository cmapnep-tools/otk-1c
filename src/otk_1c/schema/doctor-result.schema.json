{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmapnep-tools.github.io/otk-1c/schema/doctor-result.v1.json",
  "title": "Итог otk doctor --json (otk.doctor-result.v1)",
  "description": "Проверка окружения перед gate: что найдено, какие проверки доступны, что чинить (reasonCode)",
  "type": "object",
  "required": ["schema", "version", "code", "project", "environment", "checks", "warnings", "staticOnly"],
  "properties": {
    "schema": {"const": "otk.doctor-result.v1"},
    "version": {"type": "string", "description": "версия ОТК"},
    "code": {"enum": [0, 2], "description": "0 — доступны все проверки с режимом on, 2 — нет или doctor не дошёл до окружения (error)"},
    "error": {"type": "object", "required": ["status", "reasonCode", "remediation", "message"],
              "description": "код 2: почему (битый otk.toml — config_invalid, сбой ОТК — internal)",
              "properties": {"status": {"const": "infra"}, "reasonCode": {"type": "string"},
                             "remediation": {"type": "string"}, "message": {"type": "string"}}},
    "project": {"type": "object", "required": ["root", "found"],
                "properties": {"root": {"type": ["string", "null"], "description": "каталог выгрузки (null — код 2)"},
                               "found": {"type": "boolean", "description": "есть файл конфигурации"},
                               "extension": {"type": ["string", "null"]},
                               "parent": {"type": ["string", "null"], "description": "выгрузка основной конфигурации расширения"},
                               "reasonCode": {"type": "string"}, "remediation": {"type": "string"}}},
    "environment": {"type": "array",
                    "items": {"type": "object", "required": ["name", "ok", "detail"],
                              "properties": {"name": {"type": "string"}, "ok": {"type": "boolean"},
                                             "detail": {"type": ["string", "null"]},
                                             "reasonCode": {"type": "string", "description": "нет зависимости: код, как в gate-result"},
                                             "remediation": {"type": "string"}}}},
    "checks": {"type": "array",
               "items": {"type": "object", "required": ["name", "title", "mode", "state"],
                         "properties": {"name": {"type": "string"}, "title": {"type": "string"},
                                        "mode": {"enum": ["on", "auto", "off"]},
                                        "state": {"anyOf": [{"enum": ["available", "unavailable", "off"]}, {"type": "string"}]},
                                        "missing": {"type": "array", "items": {"type": "string"}},
                                        "loses": {"type": "string"},
                                        "reasonCodes": {"type": "array", "items": {"type": "string"}},
                                        "remediation": {"type": "array", "items": {"type": "string"}},
                                        "fatal": {"type": "boolean", "description": "режим on: gate завершится сбоем инфраструктуры"}}}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "staticOnly": {"type": "boolean", "description": "нет платформы 1С: доступна только статика (gate --static-only)"},
    "fromEnv": {"type": "object", "description": "ключи настроек, заданные переменными OTK_* (сильнее otk.toml): ключ -> переменная"}
  }
}
